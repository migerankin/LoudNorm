# virtualenv
.venv/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# PyInstaller: build/ and dist/ are outputs, and the .spec files are generated
# by build.ps1 rather than hand-written. The exes ship as Release assets, so
# keeping dist/ out of git is deliberate -- see "Releasing" in README.md.
build/
dist/
*.spec

# generated at build time by packaging/make_icon.py
packaging/autolevel.ico

# generated by test tones
*.wav

# editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
